# The development SQL Server, as one `mssql://` URL.
#
# `encrypt=on&trust_certificate=true` is required rather than decorative: the
# client's default mode is `Strict`, which is TDS 8.0, and SQL Server 2022 does
# not speak it. The development container's certificate is self-signed.
DATABASE_URL=mssql://sa:Password1!@db:1433/testdb?encrypt=on&trust_certificate=true